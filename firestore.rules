rules_version = '2';
// Firestore rules for FOXDROP. Paste into Firebase Console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    match /referrals/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /withdrawals/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    // Runtime settings and task lists. The Mini App listens to these documents in real time.
    // NOTE: Telegram Mini Apps do not create a Firebase Auth session, so these temporary
    // launch rules cannot securely distinguish an admin from a user. Move admin writes to
    // a trusted server using Firebase Admin before handling production funds.
    match /app_config/{docId} {
      allow read, write: if true;
    }
  }
}
